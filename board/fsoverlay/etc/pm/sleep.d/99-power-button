#!/bin/sh
# This is a workaround to an issue where pressing the power button to wake the device
# will cause the power-button script to run and sometimes cause a shutdown. Because this is before the pm-utils hooks
# we use this method to ensure the power button is effectively blocked during this brief window.

RESUME_FLAG="/var/run/power-button.wake"

case "$1" in
    suspend)
        # Record when we went to sleep. The power-button script consumes
        # this if the press that woke us arrives shortly after resume, so a
        # wake press never turns into suspend/shutdown. Do NOT clear it on
        # resume: a lid/rtc/alarm wake leaves no power-key event behind, and
        # clearing here would disarm the guard before the waker is consumed.
        date +%s > "$RESUME_FLAG" 2>/dev/null || rm -f "$RESUME_FLAG"
        ;;
    resume|thaw)
        ;;
esac

exit 0
