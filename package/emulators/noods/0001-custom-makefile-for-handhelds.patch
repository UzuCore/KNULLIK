--- /dev/null
+++ b/Makefile.handheld
@@ -0,0 +1,39 @@
+NAME     := noods
+SOURCES  := src/core src/core/arm src/core/gpu src/core/hle src/core/io src/core/memory src/ui src/ui/console src/console
+override CXXFLAGS += -std=c++11 -O3 -flto $(shell $(PKG_CONFIG) --cflags sdl2) -pthread -Isrc -D__HANDHELD__ -DGLES
+override LDFLAGS  += $(shell $(PKG_CONFIG) --libs sdl2) -lGLESv2 -pthread
+
+CXXFILES := $(foreach dir,$(SOURCES),$(wildcard $(dir)/*.cpp))
+HFILES   := $(foreach dir,$(SOURCES),$(wildcard $(dir)/*.h))
+OBJS     := $(patsubst %.cpp,%.o,$(CXXFILES))
+BUILD    := build
+FILES    := $(addprefix $(BUILD)/,$(OBJS))
+IMAGES   := $(wildcard src/ui/console/images/*.bmp)
+FILES    += $(patsubst %.bmp,$(BUILD)/%.bmp.o,$(IMAGES))
+
+VPATH := $(SOURCES)
+
+all: $(BUILD) $(NAME)
+
+$(NAME): $(FILES)
+	$(CXX) -o $@ $(FILES) $(LDFLAGS)
+
+$(BUILD)/%.bmp.o: %.bmp
+	@mkdir -p $(dir $@)
+	$(LD) -r -b binary -o $@ $<
+
+$(BUILD)/%.o: %.cpp $(HFILES)
+	@mkdir -p $(dir $@)
+	$(CXX) -c -o $@ $(CXXFLAGS) $(addprefix -I,$(SOURCES)) $<
+
+$(BUILD):
+	@mkdir -p $(BUILD)
+
+clean:
+	rm -f $(NAME)
+	rm -rf $(BUILD)
+
+install: $(NAME)
+	install -D -m 0755 $(NAME) $(DESTDIR)/usr/bin/$(NAME)
+
+.PHONY: all clean install
