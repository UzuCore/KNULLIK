config BR2_PACKAGE_ZESARUX
	bool "zesarux"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_ALSA_LIB
	help
	  ZEsarUX - ZX Second-Emulator And Released for UniX.

	  Emulates ZX Spectrum (all models), ZX80, ZX81, Sinclair QL,
	  Cambridge Z88, Jupiter Ace, Sam Coupe, Amstrad CPC, MSX,
	  Sega Master System, Colecovision, and many more.

	  Compiled with SDL2 video and audio; X11 is not required.

	  https://github.com/chernandezba/zesarux

comment "zesarux needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
