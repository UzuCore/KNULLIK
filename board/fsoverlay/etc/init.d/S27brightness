#!/bin/sh

# Check if knulli-brightness command exists
command -v knulli-brightness >/dev/null || exit 0

case $1 in
    start)
        # Retrieve the current brightness setting
        BRI=$(knulli-settings-get display.brightness 2>/dev/null)
        case "$BRI" in
            ''|*[!0-9]*) BRI=50 ;; # Missing or malformed: retain 50% default.
            *) [ "$BRI" -lt 1 ] && BRI=1 ;;
        esac

        # Boot restoration is not a manual brightness change.
        KNULLI_BRIGHTNESS_BOOT_RESTORE=1 knulli-brightness "$BRI"
        ;;
    stop)
        SAVED_BRI=$(knulli-settings-get display.brightness 2>/dev/null)

        # Get brightness values
        # User-initiated adjustments have priority over temporary PM dimming.
        if [ -s "/var/run/knulli-brightness-user-value" ]; then
            read -r CURRENT_BRI < /var/run/knulli-brightness-user-value
        elif [ -f "/var/run/knulli-brightness" ]; then
            read -r CURRENT_BRI < /var/run/knulli-brightness
        else
            CURRENT_BRI=$(knulli-brightness)
            # Last-second display off/idle dim can read as 0-1%, but is not
            # the user's saved preference. Preserve >1% unless deliberately
            # set to 1% via the explicit adjustment marker above.
            case "$CURRENT_BRI" in
                ''|*[!0-9]*) ;;
                *)
                    case "$SAVED_BRI" in
                        ''|*[!0-9]*) ;;
                        *)
                            if [ "$CURRENT_BRI" -le 1 ] && [ "$SAVED_BRI" -gt 1 ]; then
                                CURRENT_BRI="$SAVED_BRI"
                            fi
                            ;;
                    esac
                    ;;
            esac
        fi

        case "$CURRENT_BRI" in
            ''|*[!0-9]*) exit 0 ;;
        esac

        # Update saved brightness setting if it's different from the current brightness
        if [ "$SAVED_BRI" != "$CURRENT_BRI" ]; then
            if [ -e "/userdata/system/knulli.conf" ]; then
                knulli-settings-set display.brightness "$CURRENT_BRI"
            fi
        fi
        ;;
esac

exit 0
