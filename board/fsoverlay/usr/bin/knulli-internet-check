#!/bin/sh
# Exit 0 = online, 1 = offline

MODE="$1"
MAX_WAIT="${2:-0}" # Will retry until max wait time expires

case "$MAX_WAIT" in
  ''|*[!0-9]*)
    echo "internet check: invalid max wait: $MAX_WAIT"
    exit 1
    ;;
esac

GENERIC="one.one.one.one"
CHEEVOS="retroachievements.org"
UPDATES="updates.knulli.org"

has_default_route() {
  ip -4 route show default 2>/dev/null | grep -q '^default '
}

has_network_address() {
  ip -o -4 addr show up scope global 2>/dev/null |
    grep -q ' inet '
}

wifi_enabled() {
  [ "$(knulli-settings-get wifi.enabled 2>/dev/null)" = "1" ]
}

uptime_s() {
  read -r up _ < /proc/uptime 2>/dev/null || return 1
  echo "${up%%.*}"
}

# Reachability probe
http_try() {
  case "$1" in
    http://*|https://*)
      url="$1"
      ;;
    *)
      url="http://$1/"
      ;;
  esac

  curl -s --connect-timeout 2 --max-time 3 "$url" >/dev/null 2>&1
}

case "$MODE" in
  cheevos)
    TARGET="$CHEEVOS"
    ;;
  updates)
    TARGET="$UPDATES"
    ;;
  ""|generic)
    TARGET="$GENERIC"
    ;;
  *)
    TARGET="$MODE"
    ;;
esac

probe_once() {
  echo "internet check: checking $TARGET"

  if http_try "$TARGET"; then
    echo "internet check: $TARGET reachable"
    return 0
  fi

  echo "internet check: $TARGET unreachable"
  return 1
}

if [ "$MAX_WAIT" -gt 0 ]; then
  START="$(uptime_s)" || {
    echo "internet check: unable to read uptime"
    exit 1
  }
fi
SLEEP=1

while :; do
  if has_default_route; then
    probe_once && exit 0

  elif has_network_address; then
    echo "internet check: interface online but no gateway"
    exit 1

  elif ! wifi_enabled; then
    echo "internet check: no internet connection"
    exit 1

  else
    echo "internet check: network still configuring"
  fi

  [ "$MAX_WAIT" -le 0 ] && exit 1

  NOW="$(uptime_s)" || {
    echo "internet check: unable to read uptime"
    exit 1
  }
  ELAPSED=$((NOW - START))

  if [ "$ELAPSED" -ge "$MAX_WAIT" ]; then
    echo "internet check: offline (timed out after ${MAX_WAIT}s)"
    exit 1
  fi

  sleep "$SLEEP"
  [ "$SLEEP" -lt 5 ] && SLEEP=$((SLEEP + 1))
done
