#!/bin/sh

# Disabled intentionally: ROCKNIXK-style text boot mode.
# Do not start image/video splash media; keep MOTD and boot text visible.

case "$1" in
    start)
        echo "Starting splash-mpv: SKIPPED (text boot mode)"
        ;;
    stop)
        ;;
    restart|reload)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        ;;
esac

exit 0
