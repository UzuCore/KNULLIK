+	}
+
+	return size;
+}
+
+Common::String decodeSubtitleEscapes(const Common::String &input) {
+	Common::String output;
+
+	bool escaped = false;
+	for (Common::String::const_iterator it = input.begin(); it != input.end(); ++it) {
+		char c = *it;
+		if (!escaped) {
+			if (c == '\\') {
+				escaped = true;
+			} else {
+				output += c;
+			}
+			continue;
+		}
+
+		switch (c) {
+		case 'n':
+			output += '\n';
+			break;
+		case 'r':
+			output += '\r';
+			break;
+		case 't':
+			output += '\t';
+			break;
+		case '\\':
+			output += '\\';
+			break;
+		default:
+			output += '\\';
+			output += c;
+			break;
+		}
+
+		escaped = false;
+	}
+
+	if (escaped)
+		output += '\\';
+
+	return output;
+}
+
+Common::String makeSubtitleLookupKey(const Common::String &subtitleName, int32 subtitleIndex) {
+	return Common::String::format("%s|%d", subtitleName.c_str(), subtitleIndex);
+}
+
+Common::String makeSubtitleIndexFallbackKey(int32 subtitleIndex) {
+	return Common::String::format("*|%d", subtitleIndex);
+}
