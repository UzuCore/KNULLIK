#!/bin/sh

CYCLESTEP=20 # % additional brightness at each step
VALPATH=/var/run/$(basename "$0") # Stored brightness value when the display is turned off
LOCK=/var/run/$(basename "$0").lock # Mainly needed because of the dim animation

exec 9>"$LOCK"
flock 9
trap 'flock -u 9; exec 9>&-' EXIT INT TERM

BACKLIGHT_DIR=
for d in /sys/class/backlight/*; do
    if [ -d "$d" ] && [ -f "$d/brightness" ] && [ -f "$d/max_brightness" ]; then
        BACKLIGHT_DIR="$d"
        break
    fi
done

if [ -n "$BACKLIGHT_DIR" ]; then
    read -r XMAX < "$BACKLIGHT_DIR/max_brightness"
    [ -n "$XMAX" ] || XMAX=255

    bl_get() {
        read -r v < "$BACKLIGHT_DIR/brightness"
        printf '%s\n' "$v"
    }

    bl_set() {
        printf '%s' "$1" > "$BACKLIGHT_DIR/brightness"
    }
else
    # Some devices don't like a max of 255 for some reason.
    XMAX=254

    bl_get() {
        brightness get
    }

    bl_set() {
        brightness set "$1"
    }
fi

# calculate min from max
XMIN=$(( (XMAX + 99) / 100 ))
[ "$XMIN" -lt 3 ] && XMIN=3

FB_BLANK=/sys/class/graphics/fb0/blank

update_rgb_brightness() {
    [ -n "$1" ] || return 0

    knulli-board-capability "rgb" >/dev/null 2>&1 || return 0

    [ "$(knulli-settings-get led.brightness.adaptive 2>/dev/null)" = "1" ] || return 0

    curl -fsS --connect-timeout 1 --max-time 1 \
        -X POST -d "$1" \
        "http://127.0.0.1:1235/update-screen-state" >/dev/null 2>&1 || true
}

animate_brightness() {
    current=$1
    target=$2
    duration=225 # (ms) There's usually about 25ms added to the requested duration
    min_steps=2
    max_steps=8

    distance=$(( target - current ))
    abs_distance=$(( distance < 0 ? -distance : distance ))

    [ "$distance" -eq 0 ] && return 0

    steps=$abs_distance
    [ "$steps" -lt "$min_steps" ] && steps=$min_steps
    [ "$steps" -gt "$max_steps" ] && steps=$max_steps

    start_ms=$(date +%s%3N)

    i=1
    while [ "$i" -le "$steps" ]; do
        next=$(( current + (distance * i) / steps ))

        bl_set "$next" >/dev/null 2>&1

        target_ms=$(( start_ms + (duration * i) / steps ))
        now_ms=$(date +%s%3N)
        sleep_ms=$(( target_ms - now_ms ))

        if [ "$sleep_ms" -gt 0 ]; then
            sleep_s=$(awk -v ms="$sleep_ms" 'BEGIN { printf "%.4f", ms / 1000.0 }')
            sleep "$sleep_s"
        fi

        i=$(( i + 1 ))
    done
}

get_percent() {
    VAL=$1
    PCT=$(( (VAL * 100 + XMAX / 2) / XMAX ))

    [ "$PCT" -lt 0 ] && PCT=0
    [ "$PCT" -gt 100 ] && PCT=100

    printf '%d\n' "$PCT"
}

percent_to_abs() {
    PCT=$1

    if [ "$PCT" -le 0 ]; then
        printf '0\n'
    elif [ "$PCT" -eq 1 ]; then
        printf '%s\n' "$XMIN"
    elif [ "$PCT" -ge 100 ]; then
        printf '%s\n' "$XMAX"
    else
        printf '%d\n' $(( (PCT * XMAX + 50) / 100 ))
    fi
}

setValue() {
    NEWVAL=$1

    test "${NEWVAL}" -lt 0         && NEWVAL=0
    test "${NEWVAL}" -gt "${XMAX}" && NEWVAL="${XMAX}"

    bl_set "${NEWVAL}"

    update_rgb_brightness "$(get_percent "$NEWVAL")"
}

cycle() {
    X=$(bl_get)
    FVALUE=$(get_percent "$X")
    NEWVAL=$(( FVALUE + CYCLESTEP ))
    [ "$NEWVAL" -gt 100 ] && NEWVAL=0
    echo "Brightness cycling to ${NEWVAL}%"
    NEWVAL=$(percent_to_abs "$NEWVAL")
    setValue "$NEWVAL"
    exit 0
}

do_dim() {
    ABS=$(bl_get)
    PERCENT=$(get_percent "$ABS")

    if [ -e "${VALPATH}" ]; then
        exit 0
    fi

    if [ "$PERCENT" -gt 1 ]; then
        echo "${PERCENT}" > "${VALPATH}"
        animate_brightness "$ABS" "$XMIN"
    fi

    update_rgb_brightness 1
    exit 0
}

do_undim() {
    ABS=$(bl_get)

    if [ ! -e "${VALPATH}" ]; then
        exit 0
    fi

    read -r PERCENT_SAVED < "$VALPATH"
    RESTORE_ABS=$(percent_to_abs "$PERCENT_SAVED")
    animate_brightness "$ABS" "$RESTORE_ABS"
    rm -f "${VALPATH}"
    update_rgb_brightness "$PERCENT_SAVED"
    exit 0
}

display_off() {
    ABS=$(bl_get)
    PERCENT=$(get_percent "$ABS")

    if [ ! -e "${VALPATH}" ]; then
        echo "${PERCENT}" > "${VALPATH}"
    fi
    setValue 0

    if [ -z "$BACKLIGHT_DIR" ] && [ -w "$FB_BLANK" ]; then
        echo 4 > "$FB_BLANK"
    fi

    update_rgb_brightness 0
    exit 0
}

display_on() {
    if [ -z "$BACKLIGHT_DIR" ] && [ -w "$FB_BLANK" ]; then
        echo 0 > "$FB_BLANK"
        sleep 0.05
    fi

    if [ -e "${VALPATH}" ]; then
        read -r PERCENT_SAVED < "$VALPATH"
        RESTORE_ABS=$(percent_to_abs "$PERCENT_SAVED")
        setValue "$RESTORE_ABS"
        rm -f "${VALPATH}"
    else
        PERCENT_SAVED="$(get_percent "$(bl_get)")"
    fi

    update_rgb_brightness "$PERCENT_SAVED"
    exit 0
}

# get
if test $# = 0
then
    X=$(bl_get)
    get_percent "$X"
    exit 0
fi

# set
if test $# = 1
then
    if [ "${1}" = "cycle" ]; then
        cycle
    elif [ "${1}" = "dispoff" ]; then
        display_off
    elif [ "${1}" = "dispon" ]; then
        display_on
    elif [ "${1}" = "dim" ]; then
        do_dim
    elif [ "${1}" = "undim" ]; then
        do_undim
    else
        NEWVAL=$(percent_to_abs "$1")
        setValue "${NEWVAL}"
        exit 0
    fi
fi

# set +/-
if test $# = 2
then
    X=$(bl_get)
    PCT=$(get_percent "$X")
    STEP="$2"

    if [ "$1" = "+" ]; then
        # Already at max
        if [ "$X" -ge "$XMAX" ] || [ "$PCT" -ge 100 ]; then
            exit 0
        elif [ "$PCT" -eq 0 ]; then
            # 0 -> 1%
            NEWPCT=1
        elif [ "$PCT" -eq 1 ]; then
            # 1% -> requested step
            NEWPCT=$STEP
        else
            NEWPCT=$(( PCT + STEP ))
        fi
        [ "$NEWPCT" -gt 100 ] && NEWPCT=100

    elif [ "$1" = "-" ]; then
        if [ "$PCT" -le 1 ]; then
            # 1% or below -> 0
            NEWPCT=0
        else
            TMP=$(( PCT - STEP ))
            # Don't skip the 1% floor on the way down
            if [ "$TMP" -le 1 ]; then
                NEWPCT=1
            else
                NEWPCT=$TMP
            fi
        fi
    fi

    NEWVAL=$(percent_to_abs "$NEWPCT")

    [ "$NEWVAL" -eq "$X" ] && exit 0
    setValue "${NEWVAL}"
    exit 0
fi

# help
echo "${0}"      >&2
echo "${0} + 10" >&2
echo "${0} - 20" >&2
echo "${0} cycle" >&2
echo "${0} dispoff" >&2
echo "${0} dispon" >&2
echo "${0} dim" >&2
exit 1
