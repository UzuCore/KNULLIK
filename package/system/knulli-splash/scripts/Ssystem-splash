#!/bin/sh

# This is the BATOCERA system splash service
# It shows the unique BATOCERA logo in early boot stage

do_start () {
    # An initramfs-rendered KNULLIK image survives switch_root on /dev.
    # Do not repaint it with the legacy per-resolution logo.
    [ -e /dev/.knullik-splash-active ] && return 0
    [ "$(cat /boot/boot/knullik-splash.mode 2>/dev/null || true)" = motd ] && return 0

    # on some sytems, fb0 is not immediatly loaded, so, keep a chance by waiting a bit
    # are we sure all boards have fb0 ?!
    N=0
    while ! [ -e /dev/fb0 ] && [ $N -le 80 ]; do
        sleep 0.25
        N=$((N+1))
    done

    # The framebuffer may appear only after rootfs kernel modules load.
    # Prefer the same dynamically rotated, aspect-preserving BMP renderer
    # used by the initramfs. Older fbv assets remain a safe fallback.
    KNULLIK_BMP=/usr/share/knulli/splash/knullik-default-splash.bmp
    if [ "$(cat /boot/boot/knullik-splash.mode 2>/dev/null || true)" = custom ] &&
       [ -s /boot/boot/knullik-splash.bmp ]; then
        KNULLIK_BMP=/boot/boot/knullik-splash.bmp
    fi
    if [ -e /dev/fb0 ] && [ -x /usr/bin/knulli-fbboot ] && [ -s "$KNULLIK_BMP" ]; then
        KNULLIK_ROTATION=$(/usr/bin/knulli-splash-orientation /boot/boot 2>/dev/null || echo auto)
        if /usr/bin/knulli-fbboot bmp "$KNULLIK_BMP" "$KNULLIK_ROTATION" >/dev/null 2>&1; then
            : > /dev/.knullik-splash-active
            return 0
        fi
        if [ "$KNULLIK_BMP" != /usr/share/knulli/splash/knullik-default-splash.bmp ] &&
           /usr/bin/knulli-fbboot bmp /usr/share/knulli/splash/knullik-default-splash.bmp "$KNULLIK_ROTATION" >/dev/null 2>&1; then
            : > /dev/.knullik-splash-active
            return 0
        fi
    fi

    # V_BOARD_MODEL detection from knulli-info
    V_BOARD_MODEL=$(cat /sys/firmware/devicetree/base/model 2>/dev/null | tr -d '\0' | sed -e s+"[^A-Za-z0-9]"+"_"+g)
    if [ -z "${V_BOARD_MODEL}" ]; then
        # Try again with DMI
        V_BOARD_MODEL=$(cat /sys/devices/virtual/dmi/id/board_name 2>/dev/null | tr -d '\0' | sed -e s+"[^A-Za-z0-9]"+"_"+g)
    fi
    # Third time lucky?
    if [ -z "${V_BOARD_MODEL}" ] || [ "${V_BOARD_MODEL}" = "Default_string" ]; then
        V_BOARD_MODEL=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null | tr -d '\0' | sed -e s+"[^A-Za-z0-9]"+"_"+g)
    fi

    # Batocera boot logo
    image="/usr/share/knulli/splash/boot-logo-"$(cat /sys/class/graphics/fb0/virtual_size | sed 's/,/x/g')".png"
    if [ ! -f "$image" ]; then
        image="/usr/share/knulli/splash/boot-logo.png"
        [ -f "$image" ] || exit 1
    fi

    if [ "${V_BOARD_MODEL}" = "Loki_Zero" ] || [ "${V_BOARD_MODEL}" = "Retroid_Pocket_5" ] || [ "${V_BOARD_MODEL}" = "Retroid_Pocket_Flip2" ]; then
        image="/usr/share/knulli/splash/boot-logo-1080x1920-left.png"
    fi

    if [ "${V_BOARD_MODEL}" = "MIYOO_Flip" ]; then
        image="/usr/share/knulli/splash/boot-logo-640x480.png"
    fi

    if [ "${V_BOARD_MODEL}" = "Anbernic_RG_ARC_S" ]; then
        image="/usr/share/knulli/splash/boot-logo-480x640-left.png"
    fi

    if [ "${V_BOARD_MODEL}" = "RG_VITA" ]; then
        image="/usr/share/knulli/splash/boot-logo-1080x1920-left.png"
    fi

    if [ "${V_BOARD_MODEL}" = "MagicX_Mini_M" ]; then
        image="/usr/share/knulli/splash/boot-logo-480x640-left.png"
    fi

    # don't display a rotate image if the screen is not horizontal
    # we can't know if that's left or right, it depends on the device, so, just ignore
    # maybe in some case we want the rotated image for some boards. add those boards here
    if [ $(cat /sys/class/graphics/fb0/virtual_size | sed -e s+","+" -lt "+) ]; then
        # just replace in case the basic image is displayed
        if [ "${image}" = "/usr/share/knulli/splash/boot-logo.png" ]; then
            image="/usr/share/knulli/splash/boot-logo-half.png"
        fi
    fi

    FBV_OPTS="-f -e"
    # FBV_OPTS can be set differently for some boards to work
    MODELOPTS="/etc/opts.$V_BOARD_MODEL"
    [ -e "${MODELOPTS}" ] && . "${MODELOPTS}"

    [ -e /dev/fb0 ] && fbv ${FBV_OPTS} -i "${image}"
}

case "$1" in
    start)
        do_start &
        ;;
    stop)
        ;;
    *)
esac

exit $?
