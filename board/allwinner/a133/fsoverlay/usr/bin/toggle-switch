#!/bin/bash

if ! knulli-board-capability "toggleswitch"; then
    exit 1
fi

TOGGLE_STATE="/var/run/toggle-switch.state"

CUSTOM_SCRIPT="/userdata/system/switch-custom.sh"

MODE="$(/usr/bin/knulli-settings-get system.toggleswitch.mode)"
if [[ -z "$MODE" || ! "$MODE" =~ ^(mute|rgboff|airplane|custom)$ ]]; then
    MODE="mute" # default can be mute|rgboff|airplane|custom
    /usr/bin/knulli-settings-set system.toggleswitch.mode "$MODE"
fi

ACTION="$1"
case "$ACTION" in
    enable)
        case "$MODE" in
            mute)
                amixer -c 0 sset 'DAC volume' 0
                echo "mute" > "$TOGGLE_STATE"
                ;;
            rgboff)
                /usr/bin/knulli-settings-set led.enabled 0
                /etc/init.d/S95silky-rgb stop
                echo "rgboff" > "$TOGGLE_STATE"
                ;;
            airplane)
                /usr/bin/knulli-planemode enable
                echo "airplane" > "$TOGGLE_STATE"
                ;;
            custom)
                if [ -f "$CUSTOM_SCRIPT" ]; then
                    chmod +x "$CUSTOM_SCRIPT"
                    "$CUSTOM_SCRIPT" enable
                    echo "custom" > "$TOGGLE_STATE"
                else
                    echo "Custom toggle switch script not found: $CUSTOM_SCRIPT"
                fi
                ;;
        esac
        ;;
    disable)
        # Restore previously saved mode
        if [ -f "$TOGGLE_STATE" ]; then
            MODE="$(cat "$TOGGLE_STATE")"
        fi
        case "$MODE" in
            mute)
                amixer -c 0 sset 'DAC volume' 160
                ;;
            rgboff)
                /usr/bin/knulli-settings-set led.enabled 1
                /etc/init.d/S95silky-rgb start
                ;;
            airplane)
                /usr/bin/knulli-planemode disable
                ;;
            custom)
                if [ -f "$CUSTOM_SCRIPT" ]; then
                    chmod +x "$CUSTOM_SCRIPT"
                    "$CUSTOM_SCRIPT" disable
                else
                    echo "Custom toggle switch script not found: $CUSTOM_SCRIPT"

                fi
                ;;
        esac
        rm -f "$TOGGLE_STATE"
        ;;
    *)
        echo "Usage: $0 [enable|disable]"
        exit 1
        ;;
esac

exit 0
