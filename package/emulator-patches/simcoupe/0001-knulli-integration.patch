             adwButtons[nJoystick_] &= ~dwBit;
+    }
+
+    /*
+     * HotKey + Start = Quit!
+     */
+    if (nButton_ == hotKey) HotKeys[nJoystick_] = fPressed_;
+    else if (nButton_ == start) StartKeys[nJoystick_] = fPressed_;
+
+    if (HotKeys[nJoystick_] && StartKeys[nJoystick_])
