 void SetButton(int nJoystick_, int nButton_, bool fPressed_)
 {
+    int hotKey, start;
+    int a, b, x, y;
+
+    if (nJoystick_ == 0)
+    {
+      a = GetOption(joya1);
+      b = GetOption(joya1);
+      x = GetOption(joya1);
+      y = GetOption(joya1);
+      hotKey = GetOption(joyhkey1);
+      start = GetOption(joystart1);
