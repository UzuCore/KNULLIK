#!/bin/sh
#
# Broadcom AP6212 (BCM43430A1) SDIO WiFi firmware-path fixup.
#
# The rockchip bcmdhd driver is built-in and its compiled default
# firmware_path is the Android path /vendor/etc/firmware/ (empty on knulli),
# so the firmware download fails ("dongle image file ... download failed") and
# wlan0 never comes up. bcmdhd keeps the *directory* of firmware_path/nvram_path
# and regenerates the filename per detected chip (-> fw_bcm43438a1.bin /
# nvram_ap6212a.txt), so we just point both params at /lib/firmware/ap6212/
# where those files live (fw_bcm43438a1.bin ships in the base rootfs;
# nvram_ap6212a.txt is added via fsoverlay). The params are read when wlan0 is
# brought up, so setting them here (before S07network) is enough.
#
# Only acts when the AP6212 SDIO chip (02d0:a9a6) is present, so this is a no-op
# on the Realtek boards — same device-presence gating as S06wifirtw88.
#
PARAMS=/sys/module/bcmdhd/parameters
FWDIR=/lib/firmware/ap6212

is_ap6212() {
	for d in /sys/bus/sdio/devices/*; do
		[ -e "$d/vendor" ] || continue
		if [ "$(cat "$d/vendor" 2>/dev/null)" = "0x02d0" ] &&
		   [ "$(cat "$d/device" 2>/dev/null)" = "0xa9a6" ]; then
			return 0
		fi
	done
	return 1
}

start() {
	# Wait briefly for the SDIO card to enumerate after a cold boot.
	i=0
	while [ $i -lt 15 ]; do
		is_ap6212 && break
		i=$((i + 1)); sleep 1
	done
	is_ap6212 || return 0

	[ -w "$PARAMS/firmware_path" ] || return 0

	# Only the directory matters; bcmdhd rewrites the basename by chip.
	echo "$FWDIR/fw_bcmdhd.bin"  > "$PARAMS/firmware_path"
	echo "$FWDIR/nvram_bcmdhd.txt" > "$PARAMS/nvram_path"
	echo "bcmdhd: AP6212 firmware path -> $FWDIR" > /dev/kmsg 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) : ;;
	restart|reload) start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
