#!/bin/sh

# Render the canonical KNULLIK MOTD on fb0 (or the H700 text VT if available).
# Single source of truth after rootfs starts:
#   /etc/profile.d/30-welcome.sh
#
# Build-time fallback is generated from that same welcome script and copied to:
#   /usr/share/knulli/boot-motd

FBBOOT=/usr/bin/knulli-fbboot
MOTD_SCRIPT=/etc/profile.d/30-welcome.sh
VERSION_FILE=/usr/share/knulli/knulli.version
MOTD_FALLBACK=/usr/share/knulli/boot-motd
CONSOLE_MOTD_FALLBACK=/usr/share/knulli/console-motd
RAW_CACHE=/tmp/knulli-fbboot.raw-motd
COMPACT_CACHE=/tmp/knulli-fbboot.compact-motd
CONSOLE_CACHE=/tmp/knulli-console-motd.txt
LOCK=/tmp/knulli-console-motd-real-rendered

[ -x "$FBBOOT" ] || exit 0

# Custom mode displays a user image instead of the ASCII MOTD.
if [ "$(cat /boot/boot/knullik-splash.mode 2>/dev/null)" = custom ] &&
   [ -s /boot/boot/knullik-splash.bmp ]; then
    if "$FBBOOT" bmp /boot/boot/knullik-splash.bmp >/dev/null 2>&1; then
        : > "$LOCK"
        exit 0
    fi
fi

strip_ansi() {
    sed -r 's/\x1B\[[0-9;?]*[ -/]*[@-~]//g'
}

first_existing_file_line() {
    for f in "$@"; do
        [ -s "$f" ] || continue
        head -n 1 "$f" | tr -d '\r\n'
        return 0
    done
    return 1
}

make_compact_motd() {
    rm -f "$RAW_CACHE" "$COMPACT_CACHE" "$CONSOLE_CACHE" /tmp/knulli-fbboot.plain-motd /tmp/knulli-fbboot.logo-motd

    if [ -f "$MOTD_SCRIPT" ]; then
        HOME=/root TERM=linux /bin/sh "$MOTD_SCRIPT" > "$RAW_CACHE" 2>/dev/null || true
    fi

    if [ -s "$RAW_CACHE" ]; then
        strip_ansi < "$RAW_CACHE" > /tmp/knulli-fbboot.plain-motd
    else
        : > /tmp/knulli-fbboot.plain-motd
    fi

    # Prefer the literal Unicode block art from 30-welcome.sh. The fb0 renderer
    # supports U+2588, so initramfs and rootfs use the SAME logo pixels.
    awk '
        index($0, "█") { print; count++; if (count >= 9) exit }
    ' /tmp/knulli-fbboot.plain-motd > /tmp/knulli-fbboot.logo-motd

    # In case the shell MOTD is unavailable, use the generated build-time
    # output, never an independently maintained ASCII fallback logo.
    if [ ! -s /tmp/knulli-fbboot.logo-motd ]; then
        for FALLBACK in "$CONSOLE_MOTD_FALLBACK" "$MOTD_FALLBACK"; do
            [ -s "$FALLBACK" ] || continue
            awk '
                /^[[:space:]]*([Mm][Oo][Dd][Ee][Ll]|[Bb][Uu][Ii][Ll][Dd]|[Oo][Ss][[:space:]]+[Vv][Ee][Rr][Ss][Ii][Oo][Nn])[[:space:]]*:/ { exit }
                NF { print; count++; if (count >= 9) exit }
            ' "$FALLBACK" > /tmp/knulli-fbboot.logo-motd
            [ -s /tmp/knulli-fbboot.logo-motd ] && break
        done
    fi

    MODEL=$(awk -F: '
        tolower($1) ~ /^[[:space:]]*model[[:space:]]*$/ {
            v=$0; sub(/^[^:]*:[[:space:]]*/, "", v); print v; exit
        }' /tmp/knulli-fbboot.plain-motd)

    if [ -z "$MODEL" ]; then
        BOARD=$(cat /boot/boot/knulli.board 2>/dev/null || cat /boot/knulli.board 2>/dev/null || true)
        if [ -n "$BOARD" ]; then
            MODEL="ANBERNIC_$(printf '%s' "$BOARD" | tr '[:lower:]-' '[:upper:]_')"
        else
            MODEL="KNULLIK"
        fi
    fi

    BUILD=$(knulli-version 2>/dev/null || true)
    [ -n "$BUILD" ] || BUILD=$(first_existing_file_line "$VERSION_FILE" /etc/knulli.version /etc/os-release 2>/dev/null || true)
    if [ -z "$BUILD" ] && [ -s /tmp/knulli-fbboot.plain-motd ]; then
        BUILD=$(awk -F: '
            tolower($1) ~ /^[[:space:]]*(os version|version|build)[[:space:]]*$/ {
                v=$0; sub(/^[^:]*:[[:space:]]*/, "", v); print v; exit
            }' /tmp/knulli-fbboot.plain-motd)
    fi
    [ -n "$BUILD" ] || BUILD="BOOTING"

    {
        if [ -s /tmp/knulli-fbboot.logo-motd ]; then
            cat /tmp/knulli-fbboot.logo-motd
            printf '\n'
        fi
        printf '\033[36mMODEL:\033[0m %s\n' "$MODEL"
        printf '\033[36mBUILD:\033[0m %s\n' "$BUILD"
    } > "$COMPACT_CACHE"
    cp "$COMPACT_CACHE" "$CONSOLE_CACHE"
}

render_compact_motd() {
    make_compact_motd
    if [ -x /usr/bin/knulli-text-console ] && [ -s "$CONSOLE_CACHE" ] && \
        /usr/bin/knulli-text-console reset "$CONSOLE_CACHE"; then
        /usr/bin/knulli-text-console msg "Loading, please wait" >/dev/null 2>&1 || true
    elif [ -s "$COMPACT_CACHE" ]; then
        "$FBBOOT" file "$COMPACT_CACHE" >/dev/null 2>&1 || true
    elif [ -s "$MOTD_FALLBACK" ]; then
        "$FBBOOT" file "$MOTD_FALLBACK" >/dev/null 2>&1 || true
    else
        "$FBBOOT" reset "KNULLIK" >/dev/null 2>&1 || true
    fi
}

if [ ! -e "$LOCK" ]; then
    : > "$LOCK"
    render_compact_motd
else
    if ! /usr/bin/knulli-text-console msg "Loading, please wait" >/dev/null 2>&1; then
        "$FBBOOT" msg "Loading, please wait" >/dev/null 2>&1 || true
    fi
fi

exit 0
