+static int M_GetKeyCodeFromName(const char *name)
+{
+	if (name == nullptr || *name == 0)
+	{
+		return 0;
+	}
+
+	for (int i = 0; i < NUM_KEYS; ++i)
+	{
+		if (KeyNames[i] != nullptr && !stricmp(KeyNames[i], name))
+		{
+			return i;
+		}
+	}
+
+	return 0;
+}
+
+static int M_GetConfiguredMenuKey(int key)
+{
+	if (key <= 0 || key >= NUM_KEYS)
+	{
+		return NUM_MKEYS;
+	}
+
+	if (key == M_GetKeyCodeFromName(menu_confirm))
+	{
+		return MKEY_Enter;
+	}
+
+	if (key == M_GetKeyCodeFromName(menu_back))
+	{
+		return MKEY_Back;
+	}
+
+	return NUM_MKEYS;
+}
