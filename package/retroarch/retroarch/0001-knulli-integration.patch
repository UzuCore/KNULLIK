+
+   base = base ? base + 1 : path;
+   if (strncmp(base, "event", 5) != 0 || !base[5])
+      return false;
+
+   errno = 0;
+   *number = strtoul(base + 5, &end, 10);
+   return errno != ERANGE && end && *end == '\0';
+}
+
+static int sort_devnodes(const void *a, const void *b)
+{
+   const struct event_udev_entry *aa = (const struct event_udev_entry*)a;
+   const struct event_udev_entry *bb = (const struct event_udev_entry*)b;
+   unsigned long anum = 0;
+   unsigned long bnum = 0;
+   bool a_event = event_devnode_number(aa->devnode, &anum);
+   bool b_event = event_devnode_number(bb->devnode, &bnum);
+
+   if (a_event && b_event && anum != bnum)
+      return anum < bnum ? -1 : 1;
+
+   return strcmp(aa->devnode, bb->devnode);
