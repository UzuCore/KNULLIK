#!/bin/sh

# Text-only replacement for the early framebuffer logo.
# It keeps the ROCKNIXK-style boot console visible instead of drawing a bitmap.

CONSOLE=/dev/console

show_motd() {
    clear >"${CONSOLE}" 2>/dev/null || true
    if [ -f /etc/motd ]; then
        cat /etc/motd >"${CONSOLE}" 2>/dev/null || true
        echo >"${CONSOLE}"
    fi
    echo "==> Loading KNULLI, please wait..." >"${CONSOLE}"
}

case "$1" in
    start)
        show_motd
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        ;;
esac

exit 0
