#!/bin/sh

WAKE_TIME="/var/run/rtc-wake.epoch"
SHUTDOWN_FLAG="/var/run/shutdown.flag"
IDLE_STATE_FILE="/var/run/idle.state"
LOCK_FILE="/var/run/knulli-suspend.lock"

FAKE_FLAG="/var/run/knulli-suspend-fake.active"
SUSPEND_MODE="$(/usr/bin/knulli-settings-get-master system.suspendmode)"
LID_SUSPEND_REQ="/var/run/lid-close-suspend"
HALLKEY_NODE="/sys/class/power_supply/axp2202-battery/hallkey"

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  exit 0
fi

trap 'flock -u 9;' EXIT

# Abort if system is shutting down
if [ -f "$SHUTDOWN_FLAG" ]; then
  exit 0
fi

save_time() {
  local TIMER="$1"

  now=$(date +%s)
  target=$(( now + TIMER ))
  echo "$target" > "$WAKE_TIME"
}

clear_rtcs() {
  for r in /sys/class/rtc/rtc*; do
    [ -w "$r/wakealarm" ] && echo 0 > "$r/wakealarm" 2>/dev/null
  done
}

arm_rtcs() {
  secs="$1"
  armed=0
  for r in /sys/class/rtc/rtc*; do
    [ -d "$r" ] || continue
    dev="${r##*/}"

    # Allow as wake source if supported
    [ -w "$r/device/power/wakeup" ] && echo enabled > "$r/device/power/wakeup" 2>/dev/null

    # Program alarm only; don't suspend here
    if rtcwake -d "$dev" -m no -s "$secs" >/dev/null 2>&1; then
      armed=1
      continue
    fi

  done
  [ "$armed" -eq 1 ]  # returns 0 if at least one armed, 1 otherwise
}

check_auto_shutdown() {
  [ -f "$WAKE_TIME" ] || return 0
  read -r recorded < "$WAKE_TIME" 2>/dev/null || recorded=""
  rm -f "$WAKE_TIME"
  [ -n "$recorded" ] || return 0

  now=$(date +%s)
  # 10s grace period to protect against shift
  diff=$(( now - recorded ))
  [ "$diff" -lt 0 ] && diff=$(( -diff ))
  if [ "$diff" -le 10 ]; then
    knulli-shutdown -s
  fi
}

check_idle_modes() {
  local MODE
  local TIMER
  local EXTENDED_MODE
  local EXTENDED_TIMER
  local IDLE_STATE

  MODE="$(/usr/bin/knulli-settings-get system.batterysaver.mode 2>/dev/null)"
  TIMER="$(/usr/bin/knulli-settings-get system.idlewatcher.timer 2>/dev/null)"
  EXTENDED_MODE="$(/usr/bin/knulli-settings-get system.batterysaver.extendedmode 2>/dev/null)"
  EXTENDED_TIMER="$(/usr/bin/knulli-settings-get system.idlewatcher.extendedtimer 2>/dev/null)"

  # Check first if initial mode is shutdown
  if [ "$MODE" = "shutdown" ] && [ -n "$TIMER" ]; then
    printf '%s' "$TIMER"
    return 0
  fi

  # If initial mode is not shutdown, check extended mode
  if [ "$EXTENDED_MODE" = "shutdown" ]; then
    if [ -r "$IDLE_STATE_FILE" ]; then # Check if idlewatcher called suspend so we know initial mode timer is spent
      read -r IDLE_STATE < "$IDLE_STATE_FILE" 2>/dev/null
    else
      IDLE_STATE=""
    fi

    if [ "$IDLE_STATE" = "0" ]; then
      if [ -n "$EXTENDED_TIMER" ]; then
        printf '%s' "$EXTENDED_TIMER"
        return 0
      fi
    else
      if [ -n "$TIMER" ] && [ -n "$EXTENDED_TIMER" ]; then
        printf '%s' $(( TIMER + EXTENDED_TIMER ))
        return 0
      fi
    fi
  fi

  # No rtc timer
  return 1
}

do_fake_suspend() {
  action="$1"

  [ "$SUSPEND_MODE" = "fakesuspend" ] || return 1

  knulli-suspend-fake "$action"
}

do_suspend(){
  # Last-moment verification for lid-requested suspends: the lid may have
  # been opened after the caller's debounce settled but before pm-suspend
  # froze userspace. Suspending with the lid open inverts the perceived
  # suspend/wake parity, so skip instead. Other callers (power button, idle)
  # never create the request file and are unaffected.
  if [ -f "$LID_SUSPEND_REQ" ]; then
    rm -f "$LID_SUSPEND_REQ"
    HALL="$(cat "$HALLKEY_NODE" 2>/dev/null)"
    if [ -n "$HALL" ] && [ "$HALL" != "0" ]; then
      printf '%s knulli-suspend lid-open-abort\n' "$(date '+%F %T')" >> /userdata/lid-control.log 2>/dev/null || true
      return 0
    fi
  fi
  pm-is-supported --suspend >/dev/null 2>&1 && pm-suspend
}

if [ "$SUSPEND_MODE" = "fakesuspend" ] && [ -f "$FAKE_FLAG" ]; then
  do_fake_suspend wake

  rm -f "$WAKE_TIME"

  clear_rtcs
  sleep 0.5
  exit 0
fi

if rtc_secs="$(check_idle_modes)"; then
  save_time "$rtc_secs"

  if [ "$SUSPEND_MODE" != "fakesuspend" ]; then
    clear_rtcs
    if ! arm_rtcs "$rtc_secs"; then
      rm -f "$WAKE_TIME"
    fi
  fi
else
  clear_rtcs
  rm -f "$WAKE_TIME"
fi

if [ "$SUSPEND_MODE" = "fakesuspend" ]; then
  do_fake_suspend sleep
else
  do_suspend
  clear_rtcs
  check_auto_shutdown
fi

sleep 0.5 # For a small debounce

exit 0
