config BR2_PACKAGE_PPSSPP
	bool "ppsspp"
	depends on !BR2_PACKAGE_BATOCERA_TARGET_H700
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_SDL3_TTF
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_LIBGLEW if BR2_PACKAGE_BATOCERA_TARGET_X86_ANY
	select BR2_PACKAGE_LIBGLU  if BR2_PACKAGE_BATOCERA_TARGET_X86_ANY
	help
	  A  PSP emulator

