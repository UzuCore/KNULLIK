#!/bin/sh

case "$1" in
    start)
        [ -x /usr/bin/knulli-boot-status ] && \
            /usr/bin/knulli-boot-status "Loading frontend assets" >/dev/null 2>&1 || true
        ;;
    stop)
        [ -x /usr/bin/knulli-boot-status ] && \
            /usr/bin/knulli-boot-status "Frontend assets ready" >/dev/null 2>&1 || true
        ;;
esac

exit 0
