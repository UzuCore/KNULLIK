#!/bin/sh
# ROCKNIX-style bottom-left boot status renderer for Knulli.
# It keeps a small MOTD block near the lower-left of tty1 and updates one status line below it.

RUN_DIR="/run/knulli-boot-status"
STATUS_FILE="$RUN_DIR/status"
PID_FILE="$RUN_DIR/pid"
ENABLED_FILE="$RUN_DIR/enabled"
MOTD_FILE="$RUN_DIR/motd"
TTY="${BOOT_STATUS_TTY:-/dev/tty1}"

mkdir -p "$RUN_DIR"

make_motd() {
    cat > "$MOTD_FILE" <<'MOTD'
  _  __                  _  _   _         _  __
 | |/ / _ __  _  _  ___ | || | (_)       | |/ /
 | ' / | '_ \| || || || || || || |  ___  | ' /
 | . \ | | | | |_| || || || || || | |___|| . \
 |_|\_\|_| |_|\__,_||_||_||_||_||_|     |_|\_\

 _  ___   _ _   _ _     _     ___
| |/ / \ | | | | | |   | |   |_ _|
| ' /|  \| | | | | |   | |    | |
| . \| |\  | |_| | |___| |___ | |
|_|\_\_| \_|\___/|_____|_____|___|
MOTD

    if command -v knulli-version >/dev/null 2>&1; then
        echo "" >> "$MOTD_FILE"
        echo "OS version: $(knulli-version 2>/dev/null)" >> "$MOTD_FILE"
    fi
}

screen_rows() {
    local rows
    rows="$(stty size < "$TTY" 2>/dev/null | awk '{print $1}')"
    [ -n "$rows" ] || rows=24
    echo "$rows"
}

draw_once() {
    [ -e "$TTY" ] || return 0
    [ -f "$MOTD_FILE" ] || make_motd

    local rows motd_lines start row status
    rows="$(screen_rows)"
    motd_lines="$(wc -l < "$MOTD_FILE" 2>/dev/null)"
    [ -n "$motd_lines" ] || motd_lines=12
    start=$((rows - motd_lines - 2))
    [ "$start" -lt 1 ] && start=1
    status="$(cat "$STATUS_FILE" 2>/dev/null)"
    [ -n "$status" ] || status="Booting..."

    row="$start"
    # Hide cursor, draw MOTD in a fixed lower-left region, clear each line before writing.
    printf '\033[?25l' > "$TTY"
    while IFS= read -r line; do
        printf '\033[%s;1H\033[2K%s' "$row" "$line" > "$TTY"
        row=$((row + 1))
    done < "$MOTD_FILE"

    printf '\033[%s;1H\033[2K>> %s' "$row" "$status" > "$TTY"
}

start_daemon() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
        exit 0
    fi

    make_motd
    echo "Starting Knulli..." > "$STATUS_FILE"
    : > "$ENABLED_FILE"

    (
        trap 'rm -f "$ENABLED_FILE" "$PID_FILE"; printf "\033[?25h" > "$TTY" 2>/dev/null; exit 0' INT TERM EXIT
        echo $$ > "$PID_FILE"
        while [ -f "$ENABLED_FILE" ]; do
            draw_once
            sleep 0.25
        done
    ) &
}

stop_daemon() {
    rm -f "$ENABLED_FILE"
    if [ -f "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
    [ -e "$TTY" ] && printf '\033[?25h' > "$TTY" 2>/dev/null || true
}

set_status() {
    mkdir -p "$RUN_DIR"
    echo "$*" > "$STATUS_FILE"
    draw_once
}

case "$1" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    set)
        shift
        set_status "$*"
        ;;
    redraw)
        draw_once
        ;;
    *)
        echo "Usage: $0 {start|stop|set <message>|redraw}" >&2
        exit 1
        ;;
esac

exit 0
