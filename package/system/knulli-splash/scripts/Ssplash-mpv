#!/bin/sh

case "$1" in
    start)
        [ -x /usr/bin/knulli-boot-status ] && \
            /usr/bin/knulli-boot-status "Launching frontend" >/dev/null 2>&1 || true
        ;;
    stop)
        # The frontend is about to take over the display. Clear the lower
        # boot-status row and stop the watcher so it does not flicker over ES.
        [ -x /usr/bin/knulli-boot-status ] && \
            /usr/bin/knulli-boot-status --done >/dev/null 2>&1 || true
        ;;
esac

exit 0
